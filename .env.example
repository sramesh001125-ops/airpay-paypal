# Copy to .env. `npm start` loads it automatically (Node 22.9+).
PORT=3000
BASE_URL=http://localhost:3000

# mock = fully local simulation (default). live = PayPal SANDBOX APIs.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_INVOICER_EMAIL=

# Razorpay UPI rail for Indian passengers: off (default) | mock (local simulation) | test (Razorpay TEST-mode keys).
RAZORPAY_MODE=off
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Change these before any shared deployment
QR_SECRET=change-me
MOCK_WEBHOOK_SECRET=change-me
ADMIN_KEY=

# Optional AI (falls back to rules if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

LINK_TTL_MIN=60

# International airline risk caps (USD). Not regulatory limits.
INTL_PER_TXN_USD=100
INTL_PER_DEVICE_USD=1000
INTL_LINK_TTL_MIN=4320
# Optional: your own SHIELD service (receives a minimal, hashed payload). Leave empty to use the stub rules.
SHIELD_URL=
SHIELD_KEY=

# Card-backed orders (confirmed consent): airline risk caps in USD. Editable assumptions.
CARD_BACKED_PER_TXN_USD=100
CARD_BACKED_PER_DEVICE_USD=1000
# Consent form
CONSENT_VALID_HOURS=48
CONSENT_DEFAULT_CAP_INR=8500
# Demo shows the one-time code on screen. Set to 0 once a real SMS provider is connected.
DEMO_OTP=1

# SMS return-code route (mock gateway only; off by default)
SMS_MODE=off
SMS_INBOUND_NUMBER=+917000000000
